<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\UniversalMouseHub.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <AssemblyName>UniversalDeviceHub</AssemblyName>
    <Title>Universal Device Hub</Title>
    <Authors>Universal Device Hub contributors</Authors>
    <Description>Open-source Windows device manager for mice, keyboards, Bluetooth accessories, and accurate battery monitoring.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Assets\UniversalMouseHub.ico" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\DeviceImages\*.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.1.0" />
  </ItemGroup>

</Project>
