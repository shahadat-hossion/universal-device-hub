<Application x:Class="UniversalMouseHub.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 ShutdownMode="OnExplicitShutdown">
 <Application.Resources>
  <SolidColorBrush x:Key="WindowBrush" Color="#0B0D12" />
  <SolidColorBrush x:Key="CardBrush" Color="#151922" />
  <SolidColorBrush x:Key="MutedBrush" Color="#9299A8" />
  <SolidColorBrush x:Key="AccentBrush" Color="#5BD8FF" />
  <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/><Setter Property="Foreground" Value="#F5F7FA"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#071017"/><Setter Property="Background" Value="#5BD8FF"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="18,10"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Application.Resources>
</Application>
