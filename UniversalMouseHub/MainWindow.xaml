<Window x:Class="UniversalMouseHub.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Universal Device Hub" Width="1040" Height="700" MinWidth="820" MinHeight="600" WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}">
 <Window.Resources>
  <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#292D31"/><Setter Property="Foreground" Value="#F5F7FA"/></Style>
 </Window.Resources>
 <Grid>
  <Grid x:Name="HomePanel" Margin="44,32">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="28"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal"><Border Width="48" Height="48" CornerRadius="13" Background="#202A35" Margin="0,0,14,0"><TextBlock Text="●" Foreground="#5BD8FF" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="Universal Device Hub" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Mice, keyboards, and Bluetooth devices" Foreground="{StaticResource MutedBrush}" FontSize="13"/></StackPanel></StackPanel>
    <Button Grid.Column="1" Content="↻  Refresh devices" Click="AddDevice_Click" VerticalAlignment="Center"/>
   </Grid>
   <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <TextBlock Text="Mice &amp; Keyboards" FontSize="19" FontWeight="SemiBold" Margin="8,0,0,8"/>
     <ItemsControl x:Name="InputDeviceCards"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Left"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <Border Width="290" Height="470" Background="#15191C" BorderBrush="#355646" BorderThickness="1" CornerRadius="16" Margin="8" Padding="18">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><Border Grid.Column="1" Background="#163626" CornerRadius="4" Padding="9,5"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#57DE8A" Margin="0,0,7,0"/><TextBlock Text="Connected" Foreground="#57DE8A" FontSize="12" FontWeight="SemiBold"/></StackPanel></Border></Grid>
         <TextBlock Grid.Row="1" Text="{Binding Category}" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/>
         <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,0"><TextBlock Text="⌁" Foreground="#AAB2C0" FontSize="17" Margin="0,0,7,0"/><TextBlock Text="{Binding ConnectionType}" Foreground="#DDE2E8"/><Border Width="1" Height="15" Background="#353B43" Margin="13,0"/><TextBlock Text="▰" Foreground="#DDE2E8" Margin="0,0,7,0"/><TextBlock Text="{Binding BatteryLabel}" Foreground="#FFFFFF" FontWeight="SemiBold"/></StackPanel>
         <Grid Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center">
          <Border x:Name="GenericDeviceArt" Width="118" Height="194" CornerRadius="58" Background="#030405"><Grid><Border Width="4" Height="54" CornerRadius="2" Background="#11151A" VerticalAlignment="Top" Margin="0,18,0,0"/><TextBlock Text="{Binding DeviceGlyph}" Foreground="White" FontSize="54" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
          <Image x:Name="ProductImage" Source="{Binding DeviceImagePath}" Width="210" Height="245" Stretch="Uniform" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality"/>
          <Ellipse Width="160" Height="28" Fill="#101417" VerticalAlignment="Bottom" Margin="0,0,0,-20" Opacity="0.7"/>
         </Grid>
         <Button Grid.Row="4" Content="Configure" Tag="{Binding}" Click="Configure_Click" Background="#57DC8A"/>
        </Grid>
       </Border>
       <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding HasDeviceImage}" Value="True">
         <Setter TargetName="GenericDeviceArt" Property="Visibility" Value="Collapsed"/>
         <Setter TargetName="ProductImage" Property="Visibility" Value="Visible"/>
        </DataTrigger>
       </DataTemplate.Triggers>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
     <TextBlock Text="Headphones, Audio &amp; Bluetooth" FontSize="19" FontWeight="SemiBold" Margin="8,26,0,8"/>
     <ItemsControl x:Name="AudioDeviceCards" ItemTemplate="{Binding ElementName=InputDeviceCards, Path=ItemTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Left"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
     <TextBlock Text="Add a device" FontSize="19" FontWeight="SemiBold" Margin="8,26,0,8"/>
     <Border Width="290" Height="470" Background="#15191C" BorderBrush="#343A40" BorderThickness="1" CornerRadius="16" Margin="8" Padding="18">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="Add device" FontSize="18" FontWeight="Bold"/>
       <TextBlock Grid.Row="1" Text="Connect a mouse, keyboard, or Bluetooth device, then scan." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,11,0,0"/>
       <Grid Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"><Border Width="118" Height="194" CornerRadius="58" Background="#252A30" BorderBrush="#424A54" BorderThickness="1"><Grid><Border Width="8" Height="48" CornerRadius="4" Background="#0A0C0F" VerticalAlignment="Top" Margin="0,22,0,0"/><TextBlock Text="+" Foreground="#68717D" FontSize="55" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border></Grid>
       <Button Grid.Row="3" Content="＋  Add device" Click="AddDevice_Click" Style="{StaticResource SecondaryButton}"/>
      </Grid>
     </Border>
    </StackPanel>
   </ScrollViewer>
   <Grid Grid.Row="3" Margin="8,20,8,0"><CheckBox x:Name="StartupCheckBox" Content="Start automatically with Windows" Foreground="#DCE1E8" Checked="StartupCheckBox_Changed" Unchecked="StartupCheckBox_Changed"/><TextBlock HorizontalAlignment="Right" Text="Monitoring continues in the system tray" Foreground="{StaticResource MutedBrush}"/></Grid>
  </Grid>

  <Grid x:Name="DetailPanel" Visibility="Collapsed" Margin="32">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="←  Devices" Click="Back_Click" Style="{StaticResource SecondaryButton}"/><StackPanel Grid.Column="1" Margin="18,0,0,0"><TextBlock Text="Universal Device Hub" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Device overview" Foreground="{StaticResource MutedBrush}"/></StackPanel><Button Grid.Column="2" Content="↻  Refresh" Click="Refresh_Click"/></Grid>
   <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="22" Padding="30"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="DeviceNameText" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="ConnectionTypeText" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/></StackPanel><Border Grid.Column="1" Background="#122921" CornerRadius="12" Padding="13,7" VerticalAlignment="Top"><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#54E3A5" Margin="0,0,8,0"/><TextBlock x:Name="ConnectionStatusText" Text="Connected" Foreground="#7DE9B8" FontWeight="SemiBold"/></StackPanel></Border></Grid>
    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock x:Name="BatteryPercentText" Text="—" FontSize="92" FontWeight="Light" HorizontalAlignment="Center"/><TextBlock x:Name="BatteryMessageText" Text="Battery information unavailable" Foreground="{StaticResource MutedBrush}" FontSize="16" HorizontalAlignment="Center"/><Border Width="230" Height="12" Background="#292E38" CornerRadius="6" Margin="0,22,0,0" ClipToBounds="True"><Grid HorizontalAlignment="Left"><Border x:Name="BatteryFill" Width="0" Background="{StaticResource AccentBrush}" CornerRadius="6"/></Grid></Border></StackPanel>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="Status  " Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="BatteryStatusText" Text="Unavailable" FontWeight="SemiBold"/></StackPanel><TextBlock Grid.Column="1" x:Name="UpdatedText" Foreground="{StaticResource MutedBrush}"/></Grid>
   </Grid></Border>
  </Grid>
 </Grid>
</Window>
